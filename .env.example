# Copy this file to .env.local and fill in the 2 values from the shared
# Supabase project: Dashboard → Project Settings → API.
#
# Only PUBLIC values belong here: everything prefixed with VITE_ is
# bundled into the browser code where anyone can read it.
# NEVER put the database password or the service_role / secret key here.

VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
